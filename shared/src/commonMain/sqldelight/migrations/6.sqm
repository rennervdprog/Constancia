-- Migração 5 -> 6: recursos avançados de hábitos (itens 1-4).
-- Item 1: hábito quantitativo ganha PASSO (o stepper anda de passo em
-- passo, não mais de 1 em 1 fixo). A meta (target_quantity) e a unidade
-- já existiam desde a v1.
ALTER TABLE habit ADD COLUMN quantity_step REAL NOT NULL DEFAULT 1.0;

-- Item 4: integração OPT-IN por hábito, desligada por padrão:
-- mostrar o hábito no fluxo da Hoje mesmo fora dos dias devidos, e
-- mostrar marcas de check-in no
-- calendário do diário.
ALTER TABLE habit ADD COLUMN show_in_today INTEGER NOT NULL DEFAULT 0;
ALTER TABLE habit ADD COLUMN show_in_calendar INTEGER NOT NULL DEFAULT 0;

-- Item 4: check-in ganha STATUS — DONE (feito/parcial) ou SKIPPED
-- (pulado: registrado como dado, não quebra a sequência; difere da
-- simples ausência de check-in).
ALTER TABLE checkin ADD COLUMN status TEXT NOT NULL DEFAULT 'DONE';

-- Item 3: log do hábito — nota curta + emoji
-- opcionais por dia, ligados ao hábito. Fica em tabela própria para a
-- aba Padrões poder cruzar humor-por-hábito no futuro.
CREATE TABLE habit_record(
  id TEXT NOT NULL PRIMARY KEY,
  habit_id TEXT NOT NULL REFERENCES habit(id) ON DELETE CASCADE,
  date TEXT NOT NULL, -- yyyy-MM-dd
  content TEXT NOT NULL DEFAULT '',
  emoji TEXT, -- caractere emoji ou null
  created_at TEXT NOT NULL,
  UNIQUE(habit_id, date)
);
CREATE INDEX habit_record_habit ON habit_record(habit_id, date);

-- Item 2: ciclos/temporadas do hábito —
-- janela com início/fim e meta de dias; ciclos concluídos ficam
-- permanentes (completed_at preenchido), como memória do hábito.
CREATE TABLE habit_cycle(
  id TEXT NOT NULL PRIMARY KEY,
  habit_id TEXT NOT NULL REFERENCES habit(id) ON DELETE CASCADE,
  start_date TEXT NOT NULL, -- yyyy-MM-dd (inclusive)
  end_date TEXT NOT NULL, -- yyyy-MM-dd (inclusive)
  target_days INTEGER NOT NULL, -- meta de dias feitos dentro da janela
  completed_at TEXT, -- instante ISO da conclusão ou null = não concluído
  created_at TEXT NOT NULL
);
CREATE INDEX habit_cycle_habit ON habit_cycle(habit_id, start_date);
