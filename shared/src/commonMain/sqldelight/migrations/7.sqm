-- Migração 7 -> 8: Fase C do Plano de Elevação (lembretes de verdade).
-- R6.1: o lembrete único da tarefa (coluna reminder_minutes_before)
-- vira uma LISTA em tabela própria: cada linha é um lembrete relativo
-- (minutos antes da base = prazo + horário, ou 09:00) ou absoluto
-- (instante fixo em epoch millis). A coluna antiga é mantida como
-- espelho do primeiro lembrete relativo (compatibilidade).
-- R6.2: linhas com auto = 1 são o lembrete automático materializado
-- pela preferência "lembrete automático" em tarefas com horário.
CREATE TABLE task_reminder(
  id TEXT NOT NULL PRIMARY KEY,
  task_id TEXT NOT NULL REFERENCES task_item(id) ON DELETE CASCADE,
  type TEXT NOT NULL, -- RELATIVE | ABSOLUTE
  minute_offset INTEGER, -- RELATIVE: minutos antes da base ou null
  at_millis INTEGER, -- ABSOLUTE: instante epoch millis ou null
  auto INTEGER NOT NULL DEFAULT 0, -- 1 = automático (R6.2)
  created_at TEXT NOT NULL
);
CREATE INDEX task_reminder_task ON task_reminder(task_id);

-- Semeia a tabela com o lembrete único existente de cada tarefa.
INSERT INTO task_reminder(id, task_id, type, minute_offset, at_millis, auto, created_at)
SELECT 'mig7-' || id, id, 'RELATIVE', reminder_minutes_before, NULL, 0, created_at
FROM task_item WHERE reminder_minutes_before IS NOT NULL;

-- Absorvido do backlog TickTick (§9.4 do relatório): lembretes
-- MÚLTIPLOS também para hábitos, no mesmo sistema. Cada linha é um
-- horário "HH:mm" que se repete todo dia. O hábito tinha um horário
-- único (reminder_enabled/reminder_time) — vira a primeira linha.
CREATE TABLE habit_reminder(
  id TEXT NOT NULL PRIMARY KEY,
  habit_id TEXT NOT NULL REFERENCES habit(id) ON DELETE CASCADE,
  time TEXT NOT NULL, -- "HH:mm"
  created_at TEXT NOT NULL
);
CREATE INDEX habit_reminder_habit ON habit_reminder(habit_id);

-- Semeia com o horário único dos hábitos que tinham lembrete ligado.
INSERT INTO habit_reminder(id, habit_id, time, created_at)
SELECT 'mig7-' || id, id, reminder_time, created_at
FROM habit WHERE reminder_enabled = 1 AND reminder_time <> '';
