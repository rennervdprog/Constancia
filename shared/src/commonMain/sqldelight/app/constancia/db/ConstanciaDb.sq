CREATE TABLE habit(
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  icon TEXT NOT NULL,
  color INTEGER NOT NULL,
  goal_type TEXT NOT NULL, -- BINARY | QUANTITY
  target_quantity REAL NOT NULL DEFAULT 1.0,
  quantity_unit TEXT NOT NULL DEFAULT '',
  quantity_step REAL NOT NULL DEFAULT 1.0, -- passo do stepper da meta numérica (item 1)
  show_in_today INTEGER NOT NULL DEFAULT 0, -- opt-in: sempre mostrar na Hoje (item 4)
  show_in_calendar INTEGER NOT NULL DEFAULT 0, -- opt-in: marcas no calendário do diário (item 4)
  ignore_weekdays TEXT NOT NULL DEFAULT '', -- csv ISO 1..7: dias de descanso planejados (R13.1, Fase D)
  frequency_type TEXT NOT NULL, -- DAILY | WEEKLY_X | DAYS_OF_WEEK
  days_of_week TEXT NOT NULL DEFAULT '', -- csv de 1..7 (1=domingo), vazio = todos
  weekly_target INTEGER NOT NULL DEFAULT 7,
  session TEXT NOT NULL, -- MANHA | TARDE | NOITE
  reminder_enabled INTEGER NOT NULL DEFAULT 0,
  reminder_time TEXT NOT NULL DEFAULT '',
  paused INTEGER NOT NULL DEFAULT 0,
  archived INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL,
  sort_order INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE checkin(
  id TEXT NOT NULL PRIMARY KEY,
  habit_id TEXT NOT NULL REFERENCES habit(id) ON DELETE CASCADE,
  date TEXT NOT NULL, -- yyyy-MM-dd
  quantity REAL NOT NULL DEFAULT 1.0,
  status TEXT NOT NULL DEFAULT 'DONE', -- DONE | SKIPPED (pulado não quebra streak)
  created_at TEXT NOT NULL,
  UNIQUE(habit_id, date)
);
CREATE INDEX checkin_habit_date ON checkin(habit_id, date);

-- Log do hábito: nota + emoji por dia e hábito.
CREATE TABLE habit_record(
  id TEXT NOT NULL PRIMARY KEY,
  habit_id TEXT NOT NULL REFERENCES habit(id) ON DELETE CASCADE,
  date TEXT NOT NULL, -- yyyy-MM-dd
  content TEXT NOT NULL DEFAULT '',
  emoji TEXT, -- caractere emoji ou null
  created_at TEXT NOT NULL,
  UNIQUE(habit_id, date)
);
CREATE INDEX habit_record_habit ON habit_record(habit_id, date);

-- Ciclos/temporadas do hábito: janela início/fim com
-- meta de dias; completed_at preenchido = ciclo concluído (permanente).
CREATE TABLE habit_cycle(
  id TEXT NOT NULL PRIMARY KEY,
  habit_id TEXT NOT NULL REFERENCES habit(id) ON DELETE CASCADE,
  start_date TEXT NOT NULL, -- yyyy-MM-dd (inclusive)
  end_date TEXT NOT NULL, -- yyyy-MM-dd (inclusive)
  target_days INTEGER NOT NULL, -- meta de dias feitos dentro da janela
  completed_at TEXT, -- instante ISO da conclusão ou null
  created_at TEXT NOT NULL
);
CREATE INDEX habit_cycle_habit ON habit_cycle(habit_id, start_date);

CREATE TABLE task_item(
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL,
  due_time TEXT, -- HH:mm ou null
  done INTEGER NOT NULL DEFAULT 0,
  date TEXT NOT NULL, -- yyyy-MM-dd (criação/pertencimento)
  project TEXT NOT NULL DEFAULT 'entrada', -- entrada|pessoal|trabalho|casa|saude
  priority INTEGER NOT NULL DEFAULT 2, -- 1=P1 alta, 2=P2 média, 3=P3 baixa
  due_date TEXT, -- yyyy-MM-dd ou null = sem data (fica na Entrada)
  session TEXT NOT NULL DEFAULT 'TARDE', -- MANHA | TARDE | NOITE
  repeat_rule TEXT NOT NULL DEFAULT '', -- '' | 'Todo dia' | 'Seg a Sex' | 'Semanal' (rótulo legível)
  deadline_date TEXT, -- yyyy-MM-dd ou null = sem prazo final (distinto de due_date)
  duration_minutes INTEGER, -- duração estimada em minutos ou null
  completed_at TEXT, -- instante ISO da conclusão (base das metas) ou null
  reminder_minutes_before INTEGER, -- null = sem lembrete; 0 = na hora; N = N min antes
  repeat_spec TEXT NOT NULL DEFAULT '', -- regra estruturada codificada (domain/RepeatRule)
  note TEXT NOT NULL DEFAULT '',
  habit_id TEXT REFERENCES habit(id) ON DELETE SET NULL,
  created_at TEXT NOT NULL,
  sort_order INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX task_date ON task_item(date);
CREATE INDEX task_due_date ON task_item(due_date);

-- Vistas salvas das tarefas: combinações nomeadas com cor (projeto +
-- prioridade + período + agrupamento), sem linguagem de query.
CREATE TABLE saved_view(
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  color INTEGER NOT NULL,
  project TEXT, -- entrada|pessoal|trabalho|casa|saude ou null = todos
  priority INTEGER, -- 1..3 ou null = todas
  period TEXT NOT NULL DEFAULT 'all', -- all|today|week|overdue|nodate
  group_by TEXT NOT NULL DEFAULT 'none', -- none|project|priority|date
  sort_order INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL
);

-- Modelos de lista de tarefas: o modelo serializa TAREFAS (os projetos
-- são enum fixo), com modelos de fábrica semeados pelo app.
CREATE TABLE task_template(
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  is_factory INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL
);

CREATE TABLE task_template_item(
  id TEXT NOT NULL PRIMARY KEY,
  template_id TEXT NOT NULL REFERENCES task_template(id) ON DELETE CASCADE,
  title TEXT NOT NULL,
  project TEXT NOT NULL DEFAULT 'entrada',
  priority INTEGER NOT NULL DEFAULT 2,
  session TEXT NOT NULL DEFAULT 'TARDE',
  note TEXT NOT NULL DEFAULT '',
  sort_order INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL
);
CREATE INDEX template_item_template ON task_template_item(template_id);

-- Pausas da meta de tarefas: intervalos em que o streak de metas fica
-- congelado (dias perdoados), como nas pausas de hábito.
CREATE TABLE task_goal_pause(
  id TEXT NOT NULL PRIMARY KEY,
  start_date TEXT NOT NULL, -- yyyy-MM-dd (inclusive)
  end_date TEXT -- yyyy-MM-dd (inclusive) ou null = pausa aberta
);

-- Histórico de ocorrências concluídas de tarefas recorrentes (R1.1,
-- Fase B): snapshot gravado na conclusão, ANTES de gerar a próxima
-- ocorrência. A visão Feitas e os relatórios leem daqui o que a linha
-- viva não guarda mais (linha apagada/desmarcada).
CREATE TABLE task_occurrence_history(
  id TEXT NOT NULL PRIMARY KEY,
  source_task_id TEXT NOT NULL, -- id da tarefa (série) que gerou a ocorrência
  occurrence_due_date TEXT, -- yyyy-MM-dd do prazo da ocorrência ou null
  title TEXT NOT NULL,
  project TEXT NOT NULL DEFAULT 'entrada', -- entrada|pessoal|trabalho|casa|saude
  priority INTEGER NOT NULL DEFAULT 2, -- 1=P1, 2=P2, 3=P3
  deadline_date TEXT, -- yyyy-MM-dd ou null
  duration_minutes INTEGER, -- duração estimada ou null
  completed_at TEXT NOT NULL -- instante ISO da conclusão
);
CREATE INDEX occurrence_history_source ON task_occurrence_history(source_task_id);

-- Lembretes de tarefa como LISTA (R6.1, Fase C, schema v7): cada linha
-- é um lembrete relativo (minutos antes da base = prazo + horário, ou
-- 09:00 sem horário) ou absoluto (instante fixo). auto = 1 marca o
-- lembrete materializado pela preferência de lembrete automático (R6.2).
CREATE TABLE task_reminder(
  id TEXT NOT NULL PRIMARY KEY,
  task_id TEXT NOT NULL REFERENCES task_item(id) ON DELETE CASCADE,
  type TEXT NOT NULL, -- RELATIVE | ABSOLUTE
  minute_offset INTEGER, -- RELATIVE: minutos antes da base ou null
  at_millis INTEGER, -- ABSOLUTE: instante epoch millis ou null
  auto INTEGER NOT NULL DEFAULT 0, -- 1 = automático (R6.2)
  created_at TEXT NOT NULL
);
CREATE INDEX task_reminder_task ON task_reminder(task_id);

-- Lembretes de hábito (Fase C): vários
-- horários "HH:mm" por hábito, repetidos todo dia. As colunas
-- reminder_enabled/reminder_time do hábito viram espelho (ligado +
-- primeiro horário) para as telas que ordenam/exibem pelo horário.
CREATE TABLE habit_reminder(
  id TEXT NOT NULL PRIMARY KEY,
  habit_id TEXT NOT NULL REFERENCES habit(id) ON DELETE CASCADE,
  time TEXT NOT NULL, -- "HH:mm"
  created_at TEXT NOT NULL
);
CREATE INDEX habit_reminder_habit ON habit_reminder(habit_id);

-- Opções de vista persistidas por visão (R8.1, Fase B): agrupar/ordenar
-- sobrevivem a girar o celular e a trocar de aba.
-- view_key: 'view:ENTRADA'|'view:HOJE'|'view:PROXIMOS'|'view:FEITAS'|'saved:<id>'
CREATE TABLE view_options(
  view_key TEXT NOT NULL PRIMARY KEY,
  group_by TEXT NOT NULL DEFAULT 'none', -- none|project|priority|date
  sort_mode TEXT NOT NULL DEFAULT 'SMART' -- SMART|PRIORITY|DUE
);

CREATE TABLE subtask(
  id TEXT NOT NULL PRIMARY KEY,
  task_id TEXT NOT NULL REFERENCES task_item(id) ON DELETE CASCADE,
  title TEXT NOT NULL,
  done INTEGER NOT NULL DEFAULT 0,
  sort_order INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL
);
CREATE INDEX subtask_task ON subtask(task_id);

CREATE TABLE diary_entry(
  id TEXT NOT NULL PRIMARY KEY,
  date TEXT NOT NULL UNIQUE, -- yyyy-MM-dd
  mood INTEGER, -- 1..5 ou null
  note TEXT NOT NULL DEFAULT '',
  energy INTEGER, -- 1..5 ou null
  sleep_hours REAL, -- horas de sono ou null
  tags TEXT NOT NULL DEFAULT '', -- csv de etiquetas do dia
  photo_uri TEXT, -- caminho local da foto do dia ou null
  prompt TEXT, -- pergunta do dia ou null
  updated_at TEXT NOT NULL
);

CREATE TABLE challenge(
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL,
  description TEXT NOT NULL,
  duration_days INTEGER NOT NULL,
  habit_name TEXT NOT NULL,
  habit_icon TEXT NOT NULL DEFAULT '',
  start_date TEXT, -- yyyy-MM-dd ou null = ainda não iniciado
  status TEXT NOT NULL DEFAULT 'AVAILABLE', -- AVAILABLE | ACTIVE | DONE | GIVEN_UP
  is_pro INTEGER NOT NULL DEFAULT 0
);

-- Pausas: intervalos em que o hábito ficou pausado (streak congelada, sem zerar).
-- end_date null = pausa ainda aberta.
CREATE TABLE pause_interval(
  id TEXT NOT NULL PRIMARY KEY,
  habit_id TEXT NOT NULL REFERENCES habit(id) ON DELETE CASCADE,
  start_date TEXT NOT NULL, -- yyyy-MM-dd (inclusive)
  end_date TEXT -- yyyy-MM-dd (inclusive) ou null
);
CREATE INDEX pause_interval_habit ON pause_interval(habit_id);

-- Hábitos
selectHabits:
SELECT * FROM habit WHERE archived = 0 ORDER BY sort_order ASC, created_at ASC;

selectHabitById:
SELECT * FROM habit WHERE id = ?;

insertHabit:
INSERT INTO habit(id, name, icon, color, goal_type, target_quantity, quantity_unit,
  quantity_step, show_in_today, show_in_calendar, ignore_weekdays,
  frequency_type, days_of_week, weekly_target, session, reminder_enabled,
  reminder_time, paused, archived, created_at, sort_order)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateHabit:
UPDATE habit SET name = ?, icon = ?, color = ?, goal_type = ?, target_quantity = ?,
  quantity_unit = ?, quantity_step = ?, show_in_today = ?, show_in_calendar = ?,
  ignore_weekdays = ?,
  frequency_type = ?, days_of_week = ?, weekly_target = ?,
  session = ?, reminder_enabled = ?, reminder_time = ?, sort_order = ?
WHERE id = ?;

setHabitPaused:
UPDATE habit SET paused = ? WHERE id = ?;

archiveHabit:
UPDATE habit SET archived = 1 WHERE id = ?;

deleteHabit:
DELETE FROM habit WHERE id = ?;

-- Intervalos de pausa
selectPauseIntervalsForHabit:
SELECT * FROM pause_interval WHERE habit_id = ? ORDER BY start_date ASC;

selectAllPauseIntervals:
SELECT * FROM pause_interval ORDER BY habit_id ASC, start_date ASC;

openPauseInterval:
INSERT INTO pause_interval(id, habit_id, start_date, end_date)
VALUES(?, ?, ?, NULL);

closeOpenPauseIntervals:
UPDATE pause_interval SET end_date = ? WHERE habit_id = ? AND end_date IS NULL;

-- Check-ins
selectCheckin:
SELECT * FROM checkin WHERE habit_id = ? AND date = ?;

selectCheckinsForHabit:
SELECT * FROM checkin WHERE habit_id = ? ORDER BY date ASC;

selectCheckinsInRange:
SELECT * FROM checkin WHERE date >= ? AND date <= ? ORDER BY date ASC;

-- INSERT OR REPLACE em vez de ON CONFLICT DO UPDATE: o upsert moderno exige
-- SQLite 3.24+, mas o minSdk 24 roda SQLite 3.9 — REPLACE funciona desde sempre.
upsertCheckin:
INSERT OR REPLACE INTO checkin(id, habit_id, date, quantity, status, created_at)
VALUES(?, ?, ?, ?, ?, ?);

deleteCheckin:
DELETE FROM checkin WHERE habit_id = ? AND date = ?;

-- Log do hábito
selectRecord:
SELECT * FROM habit_record WHERE habit_id = ? AND date = ?;

selectRecordsForHabit:
SELECT * FROM habit_record WHERE habit_id = ? ORDER BY date DESC;

selectAllRecords:
SELECT * FROM habit_record ORDER BY date DESC;

upsertRecord:
INSERT OR REPLACE INTO habit_record(id, habit_id, date, content, emoji, created_at)
VALUES(?, ?, ?, ?, ?, ?);

deleteRecord:
DELETE FROM habit_record WHERE habit_id = ? AND date = ?;

-- Ciclos do hábito
selectCyclesForHabit:
SELECT * FROM habit_cycle WHERE habit_id = ? ORDER BY start_date ASC;

selectAllCycles:
SELECT * FROM habit_cycle ORDER BY habit_id ASC, start_date ASC;

insertCycle:
INSERT INTO habit_cycle(id, habit_id, start_date, end_date, target_days,
  completed_at, created_at)
VALUES(?, ?, ?, ?, ?, ?, ?);

completeCycle:
UPDATE habit_cycle SET completed_at = ? WHERE id = ? AND completed_at IS NULL;

-- Tarefas
selectTasksForDate:
SELECT * FROM task_item
WHERE due_date = ? OR (due_date IS NULL AND date = ?)
ORDER BY done ASC, sort_order ASC, created_at ASC;

selectAllTasks:
SELECT * FROM task_item ORDER BY created_at ASC;

selectTaskById:
SELECT * FROM task_item WHERE id = ?;

insertTask:
INSERT INTO task_item(id, title, due_time, done, date, project, priority, due_date,
  session, repeat_rule, deadline_date, duration_minutes, completed_at,
  reminder_minutes_before, repeat_spec, note, habit_id, created_at, sort_order)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

setTaskDone:
UPDATE task_item SET done = ?, completed_at = ? WHERE id = ?;

setTaskPriority:
UPDATE task_item SET priority = ? WHERE id = ?;

-- Ao mudar o prazo, o "date" acompanha (é o dia a que a tarefa pertence).
setTaskDueDate:
UPDATE task_item SET due_date = ?, date = ? WHERE id = ?;

-- Sincronia do vínculo tarefa<->hábito: concluir o hábito marca as tarefas
-- vinculadas com prazo em (hoje, ontem) — e desmarcar desmarca junto.
setLinkedTasksDone:
UPDATE task_item SET done = ? WHERE habit_id = ? AND due_date IN (?, ?);

setTaskReminder:
UPDATE task_item SET reminder_minutes_before = ? WHERE id = ?;

deleteTask:
DELETE FROM task_item WHERE id = ?;

-- Lembretes de tarefa: a lista da tarefa (R6.1, Fase C)
selectAllTaskReminders:
SELECT * FROM task_reminder ORDER BY created_at ASC, id ASC;

selectRemindersForTask:
SELECT * FROM task_reminder WHERE task_id = ? ORDER BY created_at ASC, id ASC;

insertTaskReminder:
INSERT INTO task_reminder(id, task_id, type, minute_offset, at_millis, auto, created_at)
VALUES(?, ?, ?, ?, ?, ?, ?);

deleteTaskReminder:
DELETE FROM task_reminder WHERE id = ?;

deleteRemindersForTask:
DELETE FROM task_reminder WHERE task_id = ?;

-- Lembretes de hábito: vários horários por hábito (Fase C)
selectAllHabitReminders:
SELECT * FROM habit_reminder ORDER BY habit_id ASC, time ASC;

selectRemindersForHabit:
SELECT * FROM habit_reminder WHERE habit_id = ? ORDER BY time ASC;

insertHabitReminder:
INSERT INTO habit_reminder(id, habit_id, time, created_at)
VALUES(?, ?, ?, ?);

deleteRemindersForHabit:
DELETE FROM habit_reminder WHERE habit_id = ?;

-- Espelho do lembrete no hábito (ligado + primeiro horário da lista).
setHabitReminderMirror:
UPDATE habit SET reminder_enabled = ?, reminder_time = ? WHERE id = ?;

-- Histórico de ocorrências (R1.1, Fase B)
insertOccurrenceHistory:
INSERT INTO task_occurrence_history(id, source_task_id, occurrence_due_date,
  title, project, priority, deadline_date, duration_minutes, completed_at)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?);

selectOccurrenceHistory:
SELECT * FROM task_occurrence_history ORDER BY completed_at DESC, id ASC;

deleteOccurrenceHistory:
DELETE FROM task_occurrence_history WHERE id = ?;

-- Opções de vista por visão (R8.1, Fase B)
selectViewOptions:
SELECT * FROM view_options ORDER BY view_key ASC;

-- INSERT OR REPLACE (upsert compatível com o SQLite do minSdk 24).
upsertViewOptions:
INSERT OR REPLACE INTO view_options(view_key, group_by, sort_mode)
VALUES(?, ?, ?);

-- Reagendamento em massa (item 1): todas as pendentes vencidas antes
-- de :hoje ganham o novo prazo :alvo (e o "date" acompanha).
countOverdueTasks:
SELECT COUNT(*) FROM task_item
WHERE done = 0 AND due_date IS NOT NULL AND due_date < ?;

rescheduleOverdueTasks:
UPDATE task_item SET due_date = ?, date = ?
WHERE done = 0 AND due_date IS NOT NULL AND due_date < ?;

-- Vistas salvas
selectSavedViews:
SELECT * FROM saved_view ORDER BY sort_order ASC, created_at ASC;

insertSavedView:
INSERT INTO saved_view(id, name, color, project, priority, period, group_by,
  sort_order, created_at)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteSavedView:
DELETE FROM saved_view WHERE id = ?;

-- Modelos de tarefas
selectTemplates:
SELECT * FROM task_template ORDER BY is_factory DESC, created_at ASC;

insertTemplate:
INSERT INTO task_template(id, name, is_factory, created_at)
VALUES(?, ?, ?, ?);

deleteTemplate:
DELETE FROM task_template WHERE id = ?;

countFactoryTemplates:
SELECT COUNT(*) FROM task_template WHERE is_factory = 1;

selectTemplateItems:
SELECT * FROM task_template_item ORDER BY template_id ASC, sort_order ASC, created_at ASC;

insertTemplateItem:
INSERT INTO task_template_item(id, template_id, title, project, priority,
  session, note, sort_order, created_at)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteTemplateItems:
DELETE FROM task_template_item WHERE template_id = ?;

-- Pausas da meta de tarefas
selectGoalPauses:
SELECT * FROM task_goal_pause ORDER BY start_date ASC;

insertGoalPause:
INSERT INTO task_goal_pause(id, start_date, end_date)
VALUES(?, ?, NULL);

closeOpenGoalPauses:
UPDATE task_goal_pause SET end_date = ? WHERE end_date IS NULL;

-- Subtarefas
selectAllSubtasks:
SELECT * FROM subtask ORDER BY task_id ASC, sort_order ASC, created_at ASC;

insertSubtask:
INSERT INTO subtask(id, task_id, title, done, sort_order, created_at)
VALUES(?, ?, ?, ?, ?, ?);

setSubtaskDone:
UPDATE subtask SET done = ? WHERE id = ?;

deleteSubtasksForTask:
DELETE FROM subtask WHERE task_id = ?;

-- Diário
selectDiaryForDate:
SELECT * FROM diary_entry WHERE date = ?;

selectDiaryRecent:
SELECT * FROM diary_entry ORDER BY date DESC LIMIT ?;

selectAllDiary:
SELECT * FROM diary_entry ORDER BY date DESC;

upsertDiary:
INSERT OR REPLACE INTO diary_entry(id, date, mood, note, energy, sleep_hours,
  tags, photo_uri, prompt, updated_at)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteDiaryForDate:
DELETE FROM diary_entry WHERE date = ?;

-- Desafios
selectChallenges:
SELECT * FROM challenge ORDER BY status ASC;

selectChallengeById:
SELECT * FROM challenge WHERE id = ?;

insertChallenge:
INSERT INTO challenge(id, title, description, duration_days, habit_name, habit_icon,
  start_date, status, is_pro)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?);

updateChallengeStatus:
UPDATE challenge SET status = ?, start_date = ? WHERE id = ?;
