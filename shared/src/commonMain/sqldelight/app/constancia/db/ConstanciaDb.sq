CREATE TABLE habit(
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  icon TEXT NOT NULL,
  color INTEGER NOT NULL,
  goal_type TEXT NOT NULL, -- BINARY | QUANTITY
  target_quantity REAL NOT NULL DEFAULT 1.0,
  quantity_unit TEXT NOT NULL DEFAULT '',
  frequency_type TEXT NOT NULL, -- DAILY | WEEKLY_X | DAYS_OF_WEEK
  days_of_week TEXT NOT NULL DEFAULT '', -- csv de 1..7 (1=domingo), vazio = todos
  weekly_target INTEGER NOT NULL DEFAULT 7,
  session TEXT NOT NULL, -- MANHA | TARDE | NOITE
  reminder_enabled INTEGER NOT NULL DEFAULT 0,
  reminder_time TEXT NOT NULL DEFAULT '',
  paused INTEGER NOT NULL DEFAULT 0,
  archived INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL,
  sort_order INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE checkin(
  id TEXT NOT NULL PRIMARY KEY,
  habit_id TEXT NOT NULL REFERENCES habit(id) ON DELETE CASCADE,
  date TEXT NOT NULL, -- yyyy-MM-dd
  quantity REAL NOT NULL DEFAULT 1.0,
  created_at TEXT NOT NULL,
  UNIQUE(habit_id, date)
);
CREATE INDEX checkin_habit_date ON checkin(habit_id, date);

CREATE TABLE task_item(
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL,
  due_time TEXT, -- HH:mm ou null
  done INTEGER NOT NULL DEFAULT 0,
  date TEXT NOT NULL, -- yyyy-MM-dd (criação/pertencimento)
  project TEXT NOT NULL DEFAULT 'entrada', -- entrada|pessoal|trabalho|casa|saude
  priority INTEGER NOT NULL DEFAULT 2, -- 1=P1 alta, 2=P2 média, 3=P3 baixa
  due_date TEXT, -- yyyy-MM-dd ou null = sem data (fica na Entrada)
  session TEXT NOT NULL DEFAULT 'TARDE', -- MANHA | TARDE | NOITE
  repeat_rule TEXT NOT NULL DEFAULT '', -- '' | 'Todo dia' | 'Seg a Sex' | 'Semanal'
  note TEXT NOT NULL DEFAULT '',
  habit_id TEXT REFERENCES habit(id) ON DELETE SET NULL,
  created_at TEXT NOT NULL,
  sort_order INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX task_date ON task_item(date);
CREATE INDEX task_due_date ON task_item(due_date);

CREATE TABLE subtask(
  id TEXT NOT NULL PRIMARY KEY,
  task_id TEXT NOT NULL REFERENCES task_item(id) ON DELETE CASCADE,
  title TEXT NOT NULL,
  done INTEGER NOT NULL DEFAULT 0,
  sort_order INTEGER NOT NULL DEFAULT 0,
  created_at TEXT NOT NULL
);
CREATE INDEX subtask_task ON subtask(task_id);

CREATE TABLE diary_entry(
  id TEXT NOT NULL PRIMARY KEY,
  date TEXT NOT NULL UNIQUE, -- yyyy-MM-dd
  mood INTEGER, -- 1..5 ou null
  note TEXT NOT NULL DEFAULT '',
  energy INTEGER, -- 1..5 ou null
  sleep_hours REAL, -- horas de sono ou null
  tags TEXT NOT NULL DEFAULT '', -- csv de etiquetas do dia
  photo_uri TEXT, -- caminho local da foto do dia ou null
  prompt TEXT, -- pergunta do dia ou null
  updated_at TEXT NOT NULL
);

CREATE TABLE challenge(
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL,
  description TEXT NOT NULL,
  duration_days INTEGER NOT NULL,
  habit_name TEXT NOT NULL,
  habit_icon TEXT NOT NULL DEFAULT '',
  start_date TEXT, -- yyyy-MM-dd ou null = ainda não iniciado
  status TEXT NOT NULL DEFAULT 'AVAILABLE', -- AVAILABLE | ACTIVE | DONE | GIVEN_UP
  is_pro INTEGER NOT NULL DEFAULT 0
);

-- Pausas: intervalos em que o hábito ficou pausado (streak congelada, sem zerar).
-- end_date null = pausa ainda aberta.
CREATE TABLE pause_interval(
  id TEXT NOT NULL PRIMARY KEY,
  habit_id TEXT NOT NULL REFERENCES habit(id) ON DELETE CASCADE,
  start_date TEXT NOT NULL, -- yyyy-MM-dd (inclusive)
  end_date TEXT -- yyyy-MM-dd (inclusive) ou null
);
CREATE INDEX pause_interval_habit ON pause_interval(habit_id);

-- Hábitos
selectHabits:
SELECT * FROM habit WHERE archived = 0 ORDER BY sort_order ASC, created_at ASC;

selectHabitById:
SELECT * FROM habit WHERE id = ?;

insertHabit:
INSERT INTO habit(id, name, icon, color, goal_type, target_quantity, quantity_unit,
  frequency_type, days_of_week, weekly_target, session, reminder_enabled,
  reminder_time, paused, archived, created_at, sort_order)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateHabit:
UPDATE habit SET name = ?, icon = ?, color = ?, goal_type = ?, target_quantity = ?,
  quantity_unit = ?, frequency_type = ?, days_of_week = ?, weekly_target = ?,
  session = ?, reminder_enabled = ?, reminder_time = ?, sort_order = ?
WHERE id = ?;

setHabitPaused:
UPDATE habit SET paused = ? WHERE id = ?;

archiveHabit:
UPDATE habit SET archived = 1 WHERE id = ?;

deleteHabit:
DELETE FROM habit WHERE id = ?;

-- Intervalos de pausa
selectPauseIntervalsForHabit:
SELECT * FROM pause_interval WHERE habit_id = ? ORDER BY start_date ASC;

selectAllPauseIntervals:
SELECT * FROM pause_interval ORDER BY habit_id ASC, start_date ASC;

openPauseInterval:
INSERT INTO pause_interval(id, habit_id, start_date, end_date)
VALUES(?, ?, ?, NULL);

closeOpenPauseIntervals:
UPDATE pause_interval SET end_date = ? WHERE habit_id = ? AND end_date IS NULL;

-- Check-ins
selectCheckin:
SELECT * FROM checkin WHERE habit_id = ? AND date = ?;

selectCheckinsForHabit:
SELECT * FROM checkin WHERE habit_id = ? ORDER BY date ASC;

selectCheckinsInRange:
SELECT * FROM checkin WHERE date >= ? AND date <= ? ORDER BY date ASC;

-- INSERT OR REPLACE em vez de ON CONFLICT DO UPDATE: o upsert moderno exige
-- SQLite 3.24+, mas o minSdk 24 roda SQLite 3.9 — REPLACE funciona desde sempre.
upsertCheckin:
INSERT OR REPLACE INTO checkin(id, habit_id, date, quantity, created_at)
VALUES(?, ?, ?, ?, ?);

deleteCheckin:
DELETE FROM checkin WHERE habit_id = ? AND date = ?;

-- Tarefas
selectTasksForDate:
SELECT * FROM task_item
WHERE due_date = ? OR (due_date IS NULL AND date = ?)
ORDER BY done ASC, sort_order ASC, created_at ASC;

selectAllTasks:
SELECT * FROM task_item ORDER BY created_at ASC;

selectTaskById:
SELECT * FROM task_item WHERE id = ?;

insertTask:
INSERT INTO task_item(id, title, due_time, done, date, project, priority, due_date,
  session, repeat_rule, note, habit_id, created_at, sort_order)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

setTaskDone:
UPDATE task_item SET done = ? WHERE id = ?;

setTaskPriority:
UPDATE task_item SET priority = ? WHERE id = ?;

-- Ao mudar o prazo, o "date" acompanha (é o dia a que a tarefa pertence).
setTaskDueDate:
UPDATE task_item SET due_date = ?, date = ? WHERE id = ?;

-- Sincronia do vínculo tarefa<->hábito: concluir o hábito marca as tarefas
-- vinculadas com prazo em (hoje, ontem) — e desmarcar desmarca junto.
setLinkedTasksDone:
UPDATE task_item SET done = ? WHERE habit_id = ? AND due_date IN (?, ?);

deleteTask:
DELETE FROM task_item WHERE id = ?;

-- Subtarefas
selectAllSubtasks:
SELECT * FROM subtask ORDER BY task_id ASC, sort_order ASC, created_at ASC;

insertSubtask:
INSERT INTO subtask(id, task_id, title, done, sort_order, created_at)
VALUES(?, ?, ?, ?, ?, ?);

setSubtaskDone:
UPDATE subtask SET done = ? WHERE id = ?;

-- Diário
selectDiaryForDate:
SELECT * FROM diary_entry WHERE date = ?;

selectDiaryRecent:
SELECT * FROM diary_entry ORDER BY date DESC LIMIT ?;

selectAllDiary:
SELECT * FROM diary_entry ORDER BY date DESC;

upsertDiary:
INSERT OR REPLACE INTO diary_entry(id, date, mood, note, energy, sleep_hours,
  tags, photo_uri, prompt, updated_at)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteDiaryForDate:
DELETE FROM diary_entry WHERE date = ?;

-- Desafios
selectChallenges:
SELECT * FROM challenge ORDER BY status ASC;

selectChallengeById:
SELECT * FROM challenge WHERE id = ?;

insertChallenge:
INSERT INTO challenge(id, title, description, duration_days, habit_name, habit_icon,
  start_date, status, is_pro)
VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?);

updateChallengeStatus:
UPDATE challenge SET status = ?, start_date = ? WHERE id = ?;
